# Copy this file to .env and fill it in. `npm start` and `npm run dev` load it.

# DATABASE
DEV_DATABASE=mongodb://localhost:27017/{{projectName}}
PROD_DATABASE=

PORT=5000

# CORS: allowed origins, comma-separated, or * for any
CORS_ORIGIN=*

# Requests per IP per 15 minutes on every API route
API_RATE_LIMIT=300
