{
  "name": "create-express-node-starter",
  "version": "3.0.1",
  "description": "Create a secure Express 5 and MongoDB REST API in one command: JWT authentication, uploads, Swagger docs, tests, Docker and a CRUD generator.",
  "author": "Raed Fadhlaoui <raed.fadhlaoui@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/fadhlaouir/create-express-node-starter#readme",
  "bugs": "https://github.com/fadhlaouir/create-express-node-starter/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fadhlaouir/create-express-node-starter.git"
  },
  "funding": "https://www.buymeacoffee.com/fadhlaouir",
  "keywords": [
    "create",
    "cli",
    "scaffold",
    "generator",
    "express",
    "express5",
    "mongodb",
    "mongoose",
    "rest-api",
    "jwt",
    "starter",
    "boilerplate"
  ],
  "bin": {
    "create-express-node-starter": "lib/cli.js"
  },
  "files": [
    "lib/"
  ],
  "scripts": {
    "start": "node lib/cli.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:templates": "node scripts/test-templates.mjs",
    "sync:templates": "node scripts/sync-templates.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "release": "commit-and-tag-version",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "release:dry": "commit-and-tag-version --dry-run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
