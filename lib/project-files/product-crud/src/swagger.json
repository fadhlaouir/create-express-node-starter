{
  "openapi": "3.0.3",
  "info": {
    "title": "{{projectName}}",
    "version": "1.0.0",
    "description": "Product API with Express 5 and MongoDB."
  },
  "servers": [
    {
      "url": "/v1/api"
    }
  ],
  "tags": [
    {
      "name": "Products",
      "description": "Product catalogue"
    }
  ],
  "components": {
    "schemas": {
      "Message": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ProductInput": {
        "type": "object",
        "required": ["name", "price"],
        "properties": {
          "name": {
            "type": "string",
            "example": "Blue mug"
          },
          "description": {
            "type": "string",
            "example": "Ceramic, 350 ml"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "example": 12.5
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "example": 3
          }
        }
      },
      "Product": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProductInput"
          },
          {
            "type": "object",
            "properties": {
              "_id": {
                "type": "string"
              },
              "photo": {
                "type": "string",
                "example": "uploads/3f2b8c1e-6a4d-4e2f-9b7a-1c5d8e0f2a4b.png"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      }
    },
    "responses": {
      "Message": {
        "description": "Result",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Message"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/products": {
      "post": {
        "tags": ["Products"],
        "summary": "Create a product",
        "description": "Send JSON, or multipart form data to attach a photo (JPEG, PNG, GIF or WebP, up to 5 MB).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              }
            },
            "multipart/form-data": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ProductInput"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "photo": {
                        "type": "string",
                        "format": "binary"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new product",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "product": {
                      "$ref": "#/components/schemas/Product"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Message"
          }
        }
      },
      "get": {
        "tags": ["Products"],
        "summary": "List products, newest first",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Search product names (case-insensitive)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "products": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "integer"
                        },
                        "limit": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        },
                        "pages": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/products/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": ["Products"],
        "summary": "Get a product",
        "responses": {
          "200": {
            "description": "The product",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "product": {
                      "$ref": "#/components/schemas/Product"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Message"
          }
        }
      },
      "put": {
        "tags": ["Products"],
        "summary": "Update a product",
        "description": "Only the fields sent are changed. A new photo replaces the old one.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              }
            },
            "multipart/form-data": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/ProductInput"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "photo": {
                        "type": "string",
                        "format": "binary"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated product",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "product": {
                      "$ref": "#/components/schemas/Product"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Message"
          },
          "422": {
            "$ref": "#/components/responses/Message"
          }
        }
      },
      "delete": {
        "tags": ["Products"],
        "summary": "Delete a product and its photo",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Message"
          },
          "404": {
            "$ref": "#/components/responses/Message"
          }
        }
      }
    }
  }
}
